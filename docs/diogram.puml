@startuml Sports Competition System - Use Case Diagram

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor #F5F5F5
    BorderColor #333333
    ArrowColor #333333
    FontSize 13
}
skinparam actor {
    BackgroundColor #E8F4F8
    BorderColor #333333
    FontSize 14
}

' ===== Актеры =====
actor "Гость\n(неавторизованный)" as Guest
actor "Организатор" as Organizer
actor "Игрок" as Player
actor "Тренер" as Coach

' ===== Общие варианты =====
usecase "Вход в систему\n(авторизация)" as UC_Login
usecase "Регистрация" as UC_Register

' ===== Варианты Организатора =====
usecase "Создание турнира" as UC_CreateTournament
usecase "Редактирование\nинформации о турнире" as UC_EditTournament
usecase "Добавление команды\nна турнир" as UC_AddTeamToTournament
usecase "Удаление команды\nс турнира" as UC_RemoveTeamFromTournament
usecase "Просмотр\nтурнирной таблицы" as UC_ViewStandings
usecase "Редактирование\nтурнирной таблицы" as UC_EditStandings
usecase "Изменение\nсостава команд" as UC_EditTeamRoster

' ===== Варианты Игрока =====
usecase "Просмотр\nтурнирной таблицы" as UC_ViewStandingsPlayer
usecase "Запрос на\nдобавление в команду" as UC_JoinRequest

' ===== Варианты Тренера =====
usecase "Редактирование\nсостава команды" as UC_EditRosterCoach
usecase "Добавление команды\nна турнир" as UC_AddTeamCoach
usecase "Просмотр\nтурнирной таблицы" as UC_ViewStandingsCoach

' ===== Связи Гостя =====
Guest --> UC_Login
Guest --> UC_Register

' ===== Организатор =====
Organizer --> UC_Login
Organizer --> UC_CreateTournament
Organizer --> UC_EditTournament
Organizer --> UC_AddTeamToTournament
Organizer --> UC_RemoveTeamFromTournament
Organizer --> UC_ViewStandings
Organizer --> UC_EditStandings
Organizer --> UC_EditTeamRoster

' ===== Игрок =====
Player --> UC_Login
Player --> UC_ViewStandingsPlayer
Player --> UC_JoinRequest

' ===== Тренер =====
Coach --> UC_Login
Coach --> UC_EditRosterCoach
Coach --> UC_AddTeamCoach
Coach --> UC_ViewStandingsCoach

' ===== Связь зависимости: часть функций доступна только после входа =====
UC_CreateTournament ..> UC_Login : <<include>>
UC_EditTournament ..> UC_Login : <<include>>
UC_AddTeamToTournament ..> UC_Login : <<include>>
UC_RemoveTeamFromTournament ..> UC_Login : <<include>>
UC_EditStandings ..> UC_Login : <<include>>
UC_EditTeamRoster ..> UC_Login : <<include>>
UC_JoinRequest ..> UC_Login : <<include>>
UC_EditRosterCoach ..> UC_Login : <<include>>
UC_AddTeamCoach ..> UC_Login : <<include>>

' Просмотр таблиц доступен и без входа (публично)
note bottom of UC_ViewStandings : Доступно публично\n(без авторизации)

@enduml





